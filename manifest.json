{
  "manifest_version": 3,
  "name": "KarmDown \u2014 Markdown Viewer & Editor",
  "short_name": "KarmDown",
  "version": "1.3.0",
  "description": "Read and edit Markdown files. Live preview, diagrams, math, search and export. Local processing, no analytics.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "MarkView",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "file://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "file://*/*"
      ],
      "js": [
        "vendor/marked.min.js",
        "vendor/dompurify.min.js",
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "include_globs": [
        "*.md*",
        "*.mD*",
        "*.Md*",
        "*.MD*",
        "*.markdown*",
        "*.markdowN*",
        "*.markdoWn*",
        "*.markdoWN*",
